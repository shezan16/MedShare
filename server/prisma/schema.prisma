generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DONOR
  PHARMACY
  ADMIN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequestStatus {
  PENDING
  VERIFIED
  SEARCHING
  NOTIFIED
  DONOR_ACCEPTED
  DONOR_CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ResponseStatus {
  NOTIFIED
  ACCEPTED
  DECLINED
  CONFIRMED
  COMPLETED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MedicineRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DISPENSED
  CANCELLED
}

enum NotificationType {
  EMERGENCY_BLOOD
  DONOR_ACCEPT
  MEDICINE_UPDATE
  VERIFICATION
  SYSTEM
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            Role             @default(PATIENT)
  isVerified      Boolean          @default(false)
  profileImage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  donor           Donor?
  pharmacy        Pharmacy?
  bloodRequests   BloodRequest[]
  medicineRequests MedicineRequest[]
  notifications   Notification[]
  reportsSubmitted UserReport[]     @relation("Reporter")
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role])
}

model Donor {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  bloodGroup        BloodGroup
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  latitude          Float
  longitude         Float
  lastDonationDate  DateTime?
  isAvailable       Boolean            @default(true)
  preferredRadiusKm Float              @default(5.0)
  responseRate      Float              @default(100.0)
  donationCount     Int                @default(0)
  verificationStatus VerificationStatus @default(PENDING)
  verificationDocs  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  responses         DonorResponse[]
  donations         DonationHistory[]

  @@index([bloodGroup, isAvailable])
  @@index([latitude, longitude])
  @@index([verificationStatus])
}

model Hospital {
  id            String         @id @default(uuid())
  name          String
  address       String
  latitude      Float
  longitude     Float
  phone         String
  email         String?
  isVerified    Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  bloodRequests BloodRequest[]

  @@index([latitude, longitude])
}

model BloodRequest {
  id              String            @id @default(uuid())
  requestNumber   String            @unique
  requesterId     String
  requester       User              @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  patientName     String
  bloodGroup      BloodGroup
  unitsRequired   Int               @default(1)
  hospitalId      String?
  hospital        Hospital?         @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  hospitalName    String
  hospitalAddress String
  hospitalLat     Float
  hospitalLng     Float
  requiredDate    DateTime
  priority        Priority          @default(HIGH)
  contactPerson   String
  contactPhone    String
  additionalNotes String?
  status          RequestStatus     @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  donorResponses  DonorResponse[]
  donationHistories DonationHistory[]

  @@index([bloodGroup, status])
  @@index([hospitalLat, hospitalLng])
  @@index([priority, status])
}

model DonorResponse {
  id                  String         @id @default(uuid())
  bloodRequestId      String
  bloodRequest        BloodRequest   @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  donorId             String
  donor               Donor          @relation(fields: [donorId], references: [id], onDelete: Cascade)
  status              ResponseStatus @default(NOTIFIED)
  responseTimeMinutes Float?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([bloodRequestId, donorId])
  @@index([status])
}

model Pharmacy {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName   String
  licenseNumber      String             @unique
  address            String
  latitude           Float
  longitude          Float
  phone              String
  email              String
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  medicines          Medicine[]
  verifications      PharmacyVerification[]

  @@index([verificationStatus])
  @@index([latitude, longitude])
}

model PharmacyVerification {
  id           String             @id @default(uuid())
  pharmacyId   String
  pharmacy     Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  documentUrls String
  verifiedBy   String?
  notes        String?
  status       VerificationStatus @default(PENDING)
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([pharmacyId])
}

model Medicine {
  id                  String             @id @default(uuid())
  pharmacyId          String
  pharmacy            Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name                String
  genericName         String
  brandName           String?
  strength            String
  dosageForm          String
  manufacturer        String
  batchNumber         String
  mfgDate             DateTime
  expiryDate          DateTime
  quantity            Int
  packagingCondition  String
  storageCondition    String
  requiresPrescription Boolean           @default(true)
  requiresColdChain   Boolean            @default(false)
  source              String
  imageUrl            String?
  verificationStatus  VerificationStatus @default(PENDING)
  safetyNotes         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  images              MedicineImage[]
  requests            MedicineRequest[]
  verifications       MedicineVerification[]

  @@index([genericName])
  @@index([expiryDate])
  @@index([verificationStatus])
}

model MedicineImage {
  id            String   @id @default(uuid())
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  imageUrl      String
  ocrRawText    String?
  ocrConfidence Float?
  createdAt     DateTime @default(now())

  @@index([medicineId])
}

model MedicineRequest {
  id                String                @id @default(uuid())
  requesterId       String
  requester         User                  @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine              @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  quantityRequested Int                   @default(1)
  prescriptionUrl   String?
  reason            String
  status            MedicineRequestStatus @default(PENDING)
  pharmacyNotes     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([medicineId])
}

model MedicineVerification {
  id         String             @id @default(uuid())
  medicineId String
  medicine   Medicine           @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  verifiedBy String?
  status     VerificationStatus @default(PENDING)
  notes      String?
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([medicineId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  data      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model DonationHistory {
  id             String        @id @default(uuid())
  donorId        String
  donor          Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  bloodRequestId String?
  bloodRequest   BloodRequest? @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)
  donationDate   DateTime      @default(now())
  unitsDonated   Int           @default(1)
  hospitalName   String
  certificateUrl String?
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([donorId])
}

model UserReport {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedItemId String?
  itemType       String
  reason         String
  details        String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
